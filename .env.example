# Copy this file to .env (root) and to apps/api/.env, then adjust if needed.

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=cmt
POSTGRES_PASSWORD=cmt_dev_password
POSTGRES_DB=cmt
DATABASE_URL=postgresql://cmt:cmt_dev_password@localhost:5432/cmt?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173

# Auth (Roei) - generate long random strings, never commit real values
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Email (Daniel)
RESEND_API_KEY=

# Sentry (optional locally - leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# true = enables GET /api/health/sentry-test, which throws an error on purpose
SENTRY_DEBUG=false

# Web (Vite reads these from apps/web/.env - only VITE_* variables reach the browser)
# VITE_API_URL=https://<your-render-service>.onrender.com/api
# VITE_SENTRY_DSN=
