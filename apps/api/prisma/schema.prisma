// Database schema. Owner: Database & Service Engine (Ilay).
// After changing this file run: pnpm db:migrate
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum Role {
  PRIVATE
  BUSINESS
}

enum VehicleType {
  CAR
  MOTORCYCLE
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
}

enum ReminderType {
  SERVICE
  TEST
  INSURANCE
  UPDATE_KM
}

enum ReminderStatus {
  PENDING
  SENT
  DONE
}

// ==========================================
// Models
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PRIVATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles      Vehicle[]
  refreshTokens RefreshToken[]
}

model Vehicle {
  id          String      @id @default(uuid())
  userId      String
  plate       String
  make        String
  model       String
  year        Int
  vehicleType VehicleType @default(CAR)
  fuelType    FuelType
  currentKm   Int         @default(0)
  kmUpdatedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRecords ServiceRecord[]
  reminders      Reminder[]

  @@unique([userId, plate])
  @@index([userId])
}

model ServiceTemplate {
  id             String   @id @default(uuid())
  make           String
  model          String
  yearFrom       Int
  yearTo         Int
  fuelType       FuelType
  serviceKey     String // e.g. "oil-change" (matches ServiceTemplateItem.id)
  name           String
  intervalKm     Int?
  intervalMonths Int?
  firstAtKm      Int?
  actions        String[]
  parts          Json // ServicePart[] JSON array
  costMin        Int?
  costMax        Int?
  source         String // Manufacturer manual name + edition/page reference
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([make, model, yearFrom, yearTo, fuelType, serviceKey])
  @@index([make, model])
}

model ServiceRecord {
  id         String   @id @default(uuid())
  vehicleId  String
  serviceKey String // Matches ServiceTemplate.serviceKey (e.g. "oil-change")
  date       DateTime
  km         Int
  cost       Int?
  notes      String?
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Reminder {
  id        String         @id @default(uuid())
  vehicleId String
  type      ReminderType   @default(SERVICE)
  dueDate   DateTime?
  dueKm     Int?
  status    ReminderStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime       @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([status, dueDate])
  @@index([vehicleId])
}

// One row per issued refresh token (DevSecOps: rotation + revocation).
// The row id is the JWT "jti" claim. Each refresh marks the old row as revoked and creates a new one
// in the same family. Using an already-revoked token means it was stolen -> the whole family is revoked.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String // All tokens that came from one login share a family
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}
