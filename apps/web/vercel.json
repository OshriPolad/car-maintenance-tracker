{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @cmt/web...",
  "buildCommand": "cd ../.. && pnpm --filter @cmt/shared build && pnpm --filter @cmt/web build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
