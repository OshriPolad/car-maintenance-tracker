{
  "name": "car-maintenance-tracker",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "\u003e=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cmt/shared build \u0026\u0026 pnpm -r --parallel --filter \"./apps/*\" --filter @cmt/shared dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @cmt/shared build \u0026\u0026 pnpm -r typecheck",
    "test": "pnpm --filter @cmt/shared build \u0026\u0026 pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @cmt/api prisma:migrate",
    "db:studio": "pnpm --filter @cmt/api prisma:studio",
    "db:seed": "pnpm --filter @cmt/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
